rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero insecure defaults: deny all unmatched document paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Strictly isolated owner-bound user space
    match /users/{userId} {
      // Allow user to read and write their own profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Isolated multi-turn interactions and journal entries
      match /interactions/{interactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Isolated AI-extracted and custom goals
      match /goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Isolated weekly reflections and thematic insights
      match /insights/{insightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Recursive fallback for any future nested user subcollections
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
