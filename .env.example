# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
# In Google Cloud Run, mount this from Google Cloud Secret Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENABLE_DEMO_MODE: Enables mock token authentication for local development and
# AI Studio embedded preview, where Firebase Google OAuth popups are unavailable.
# MUST be "false" or absent in all production deployments.
# The server will refuse to start if this is "true" when NODE_ENV=production.
ENABLE_DEMO_MODE="false"

# Firebase Client Configuration (Public variables safe for browser initialization)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
